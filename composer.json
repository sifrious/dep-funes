{
    "name": "sifrious/funes",
    "description": "Historical record substrate with provenance, identity, and idempotent ingestion.",
    "keywords": [
        "laravel",
        "history",
        "provenance",
        "events",
        "memory"
    ],
    "homepage": "https://github.com/sifrious/funes",
    "license": "proprietary",
    "authors": [
        {
            "name": "sifrious",
            "email": "mmebit@icloud.com"
        }
    ],
    "require": {
        "php": "^8.4.1",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "sifrious/reference-contract": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Sifrious\\Funes\\": "src/"
        },
        "files": [
            "src/diagram.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sifrious\\Funes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse",
        "diagram:fixtures": "php bin/diagram-fixtures.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/sifrious/dep-reference-contract.git"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Sifrious\\Funes\\FunesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
